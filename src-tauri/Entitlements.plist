<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The codesign step enables the hardened runtime; without this
         entitlement it silently denies microphone access before TCC can
         even prompt (the app never appears in the Microphone list). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
