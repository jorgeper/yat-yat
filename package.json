{
  "name": "yat-yat",
  "private": true,
  "version": "0.1.0-alpha.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test --release",
    "validate": "node scripts/validate.mjs",
    "clean:app": "bash scripts/deep-clean.sh",
    "install:app": "pkill -x yat-yat; rm -rf '/Applications/Yat Yat.app' && ditto 'src-tauri/target/release/bundle/macos/Yat Yat.app' '/Applications/Yat Yat.app' && tccutil reset Accessibility com.yatyat.app >/dev/null && echo 'Accessibility grant reset (ad-hoc builds re-key it) — the app will walk you through re-granting.' && open '/Applications/Yat Yat.app'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tauri-plugin-macos-permissions-api": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
